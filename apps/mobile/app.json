{
  "expo": {
    "name": "CLAN",
    "slug": "classroom-lan",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.classroomlan.student",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "CLAN finds and connects to nearby CLANs and people on this Wi-Fi, a hotspot or directly between iPhones. No internet is used.",
        "NSBonjourServices": [
          "_clanlink._tcp",
          "_clanpeer._tcp",
          "_clansync._tcp",
          "_classroomlan._tcp"
        ],
        "NSCameraUsageDescription": "CLAN uses the camera when you scan a CLAN code (a person, a CLAN or an optical file transfer) or take a photo for your Inbox.",
        "NSPhotoLibraryUsageDescription": "CLAN opens your photos only when you pick one to save in your Inbox or send in a chat.",
        "NSMicrophoneUsageDescription": "CLAN uses the microphone only while you record a voice message or are in a call you started or answered.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSBluetoothAlwaysUsageDescription": "CLAN uses Bluetooth to find a nearby CLAN host that runs its own network. Only pairing messages are exchanged.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "entitlements": {
        "com.apple.developer.networking.HotspotConfiguration": true
      }
    },
    "android": {
      "package": "app.classroomlan.student",
      "versionCode": 2,
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "*/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "*/*"
            }
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "CLAN uses the camera when you scan a CLAN code (a person, a CLAN or an optical file transfer) or take a photo for your Inbox.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CLAN uses the microphone only while you record a voice message or are in a call you started or answered."
        }
      ],
      "@react-native-community/datetimepicker",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "./plugins/withShareExtension.js",
      "./plugins/withReleaseSigning.js",
      "./plugins/withNoRemotePush.js"
    ],
    "scheme": "clan"
  }
}
