{
  "expo": {
    "name": "CLAN",
    "slug": "classroom-lan",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.classroomlan.student",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "CLAN finds and connects to nearby CLANs on this Wi-Fi network. No internet is used.",
        "NSBonjourServices": [
          "_classroomlan._tcp",
          "_clansync._tcp"
        ],
        "NSCameraUsageDescription": "CLAN uses the camera only when you take a photo to save in your Inbox.",
        "NSPhotoLibraryUsageDescription": "CLAN opens your photos only when you pick one to save in your Inbox or send in a chat.",
        "NSMicrophoneUsageDescription": "CLAN never turns on the microphone. iOS asks for this text because the screen-sharing library it includes can use audio devices.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSBluetoothAlwaysUsageDescription": "CLAN uses Bluetooth to find a nearby CLAN host that runs its own network. Only pairing messages are exchanged."
      },
      "entitlements": {
        "com.apple.developer.networking.HotspotConfiguration": true
      }
    },
    "android": {
      "package": "app.classroomlan.student",
      "versionCode": 1,
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.CHANGE_WIFI_STATE"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "*/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "*/*"
            }
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO", "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "./plugins/withShareExtension.js",
      "./plugins/withReleaseSigning.js",
      "./plugins/withNoRemotePush.js"
    ],
    "scheme": "clan"
  }
}
