// Bundles the official OPAQUE WASM build + bridge into ONE self-contained HTML string for the WebView.
// Output: src/generated/opaqueBridgeHtml.ts (checked in so Metro builds need no extra step; regenerate with
// `pnpm --filter @classroom/mobile build:bridge`). No remote content, strict CSP, nothing but this script can run.
import { build } from 'vite';
import { createHash } from 'node:crypto';
import { writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const root = fileURLToPath(new URL('..', import.meta.url));
const res = await build({
  root, logLevel: 'warn', configFile: false,
  build: { write: false, minify: true, lib: { entry: 'bridge/entry.ts', formats: ['iife'], name: 'ClassroomOpaqueBridge', fileName: () => 'bridge.js' } },
});
const js = (Array.isArray(res) ? res[0]! : res as { output: { code?: string }[] }).output.find((o) => 'code' in o && o.code)!.code!;
if (/<\/script/i.test(js)) throw new Error('bundle contains </script>');
// 'wasm-unsafe-eval' lets WebAssembly compile without allowing eval(); no connect/img/frame sources at all.
const html = `<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline' 'wasm-unsafe-eval'"></head><body><script>${js}</script></body></html>`;
const sha = createHash('sha256').update(html).digest('hex');
writeFileSync(new URL('../src/generated/opaqueBridgeHtml.ts', import.meta.url),
  `// GENERATED by scripts/build-opaque-bridge.mts from @serenity-kit/opaque 1.1.0 — do not edit.\n` +
  `export const OPAQUE_BRIDGE_SHA256 = '${sha}';\nexport const OPAQUE_BRIDGE_HTML = ${JSON.stringify(html)};\n`);
console.log(`bridge: ${(html.length / 1024).toFixed(0)} KB, sha256 ${sha}`);
