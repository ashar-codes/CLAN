{
  "name": "@classroom/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "expo prebuild -p android && cd android && ./gradlew assembleRelease",
    "build:ios": "expo prebuild -p ios && echo 'Open ios/*.xcworkspace in Xcode to archive'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:bridge": "node scripts/build-opaque-bridge.mts"
  },
  "dependencies": {
    "@classroom/client": "workspace:*",
    "@classroom/protocol": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1",
    "react-native-zeroconf": "^0.17.3",
    "@clan/design": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "^7.0.2",
    "@serenity-kit/opaque": "1.1.0",
    "vite": "^8.3.2"
  }
}
