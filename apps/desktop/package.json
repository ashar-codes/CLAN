{
  "name": "@classroom/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLAN desktop app",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && vite build",
    "start": "electron .",
    "dist": "pnpm build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && vite build && vitest run -c vitest.e2e.config.ts",
    "dist:dir": "pnpm build && electron-builder --dir -c.mac.identity=-"
  },
  "devDependencies": {
    "@clan/core": "workspace:*",
    "@clan/design": "workspace:*",
    "@clan/world": "workspace:*",
    "@classroom/client": "workspace:*",
    "@classroom/protocol": "workspace:*",
    "@classroom/server": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "@serenity-kit/opaque": "1.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "livekit-client": "2.22.3",
    "playwright-core": "^1.63.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "0.186.1",
    "vite": "^8.3.2",
    "zod": "^4.6.5"
  },
  "author": "CLAN",
  "dependencies": {
    "pdfjs-dist": "6.3.289",
    "qrcode": "1.5.4"
  }
}