{
  "name": "@classroom/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Classroom LAN desktop app (teacher + student)",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && vite build",
    "start": "electron .",
    "dist": "pnpm build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "pnpm build && vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@classroom/client": "workspace:*",
    "@classroom/protocol": "workspace:*",
    "@classroom/server": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2"
  }
}