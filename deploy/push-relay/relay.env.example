# /etc/clan-relay/relay.env  (chmod 600, owner clanrelay). Never commit the real file or the key files.
CLAN_RELAY_HOST=127.0.0.1
CLAN_RELAY_PORT=8443
CLAN_RELAY_DB=/var/lib/clan-relay/relay.db
CLAN_RELAY_TRUST_PROXY=1
# Firebase service account JSON with the "Firebase Cloud Messaging API Admin" role (chmod 400)
CLAN_FCM_SERVICE_ACCOUNT=/etc/clan-relay/firebase-sa.json
# iOS (out of scope for this phase): CLAN_APNS_KEY=… CLAN_APNS_KEY_ID=… CLAN_APNS_TEAM_ID=… CLAN_APNS_TOPICS=…
